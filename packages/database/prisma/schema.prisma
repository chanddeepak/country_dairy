datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
//
// Rule of thumb applied here: an enum is for a closed set the *code* branches
// on. Anything a catalog manager should be able to extend without a migration
// (packaging vessels, product attributes) is a table instead — that is what
// keeps this schema usable when we add oil, honey, or anything past dairy.
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  SUPER_ADMIN
  CATALOG_MANAGER
  ORDER_MANAGER
  DELIVERY_DRIVER
}

enum AuthProvider {
  PHONE
  EMAIL
  GOOGLE
  APPLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  /// Cashfree Payment Gateway, and the One Click Checkout built on it.
  /// Razorpay stays listed so existing rows keep resolving.
  CASHFREE
  COD
  WALLET
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionFrequency {
  DAILY
  ALTERNATE_DAYS
  WEEKLY
  CUSTOM_DAYS
}

enum DeliveryStatus {
  SCHEDULED
  DISPATCHED
  DELIVERED
  SKIPPED
  FAILED
}

enum TransactionType {
  CREDIT
  DEBIT
}

// Lifecycle only. Availability is derived from variant stock (or an explicit
// forceOutOfStock override) — storing "out of stock" here caused status/stock
// drift in the previous model.
enum ProductStatus {
  DRAFT
  LIVE
  ARCHIVED
}

enum DeliveryType {
  LOCAL
  COURIER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum BannerType {
  DESKTOP
  MOBILE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum StockMovementReason {
  MANUAL_ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_RETURNED
  RESTOCK
  SUBSCRIPTION_DELIVERY
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid())
  name         String?
  phone        String? @unique
  email        String? @unique
  passwordHash String?
  role         Role    @default(CUSTOMER)
  isActive     Boolean @default(true)

  /// Set when the customer exercises their right to erasure under the DPDP
  /// Act. The row survives because orders must reference a buyer and the
  /// invoices are retained for GST, but every identifying field on it is
  /// cleared. See AuthService.deleteOwnAccount for exactly what is kept.
  deletedAt DateTime?

  /// Per-channel consent. Defaults to on for email because a customer who
  /// places an order has asked to be told what happens to it; marketing on any
  /// channel is a separate switch the store does not have yet.
  emailOptIn    Boolean   @default(true)
  smsOptIn      Boolean   @default(true)
  whatsappOptIn Boolean   @default(true)
  walletBalance Decimal   @default(0.00) @db.Decimal(10, 2)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  identities      AuthIdentity[]
  addresses       Address[]
  orders          Order[]
  subscriptions   Subscription[]
  transactions    WalletTransaction[]
  cartItems       CartItem[]
  reviews         ProductReview[]
  auditLogs       AuditLog[]
  resetTokens     PasswordResetToken[]
  assignedOrders  Order[]              @relation("DriverAssignment")
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

// One user, many login methods. Adding Sign in with Apple (required by the App
// Store once we offer Google sign-in) costs a token verifier and no migration.
// This also fixes the duplicate-account bug: previously a phone signup followed
// by a Google login created two unrelated users with separate wallets.
model AuthIdentity {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  providerId String // phone number, email, or the provider's subject claim
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

// OTP must survive a redeploy and be shared across API instances — the previous
// in-memory Map broke on both.
model OtpVerification {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  /// Who asked. Rate limiting by phone alone stops nothing: an attacker cycles
  /// numbers and every request looks like a different customer, while each one
  /// spends a real message.
  requestIp  String?

  @@index([phone, expiresAt])
  @@index([requestIp, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  phone      String?
  isDefault  Boolean  @default(false)
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// How a collection is meant to be used, so the storefront can render each
/// kind in its own place rather than dumping them all in one nav menu.
enum CollectionType {
  /// "Gut Health", "Immunity" — what the customer is shopping *for*. A ghee
  /// belongs to several at once, which is why this is not a Category: a
  /// product has exactly one of those.
  CONCERN
  /// "Diwali Gifting", "Monsoon" — seasonal, and usually date-bound.
  OCCASION
  /// "Best Seller", "New Launch" — a badge on the card.
  BADGE
  /// "Saver Combos" — a hand-picked shelf.
  CURATED
}

/// A merchandising grouping that cuts across the category tree.
model Collection {
  id           String         @id @default(uuid())
  slug         String         @unique
  title        String
  subtitle     String?
  description  String?
  type         CollectionType @default(CURATED)
  iconName     String?
  imageUrl     String?
  /// Seasonal shelves appear and retire on their own rather than needing
  /// somebody to remember on the morning of the festival.
  startsAt     DateTime?
  endsAt       DateTime?
  displayOrder Int            @default(1)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  products ProductCollection[]

  @@index([type, isActive, displayOrder])
  @@index([startsAt, endsAt])
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  displayOrder Int        @default(1)

  @@id([productId, collectionId])
  @@index([collectionId, displayOrder])
}

model Category {
  id            String     @id @default(uuid())
  /// Stable numeric id, for the same reason as Product.externalId — a feed
  /// consumer that cannot hold a UUID needs a long.
  externalId  BigInt   @unique @default(autoincrement())
  name          String
  slug          String     @unique
  description   String?
  imageUrl      String?
  iconName      String?    @default("Package")
  displayOrder  Int        @default(1)
  isActive      Boolean    @default(true)
  /// Promoted to the navigation bar rather than living in its dropdown.
  ///
  /// A merchandising decision, not a structural one — which is why it is a
  /// flag and not a level. Both comparable brands in this market keep the bar
  /// flat and promote a handful, rather than nesting it.
  showInNav     Boolean    @default(false)
  parentId      String?
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[] @relation("SubCategories")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, displayOrder])
}

// Was a hardcoded enum of dairy vessels (GLASS_JAR, METAL_DOLCHI, ECO_POUCH).
// As a table, adding "Amber Glass Bottle" for cold-pressed oil or a honey
// squeeze bottle is an admin action, not a migration + redeploy.
model PackagingOption {
  id           String   @id @default(uuid())
  code         String   @unique
  label        String
  displayOrder Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants ProductVariant[]
}

model Product {
  id               String        @id @default(uuid())
  /// A stable numeric id for systems that cannot hold a UUID. An external
  /// system stores it and sends it back on every order, so it must never be
  /// reused — a recycled number points their existing orders
  /// at a different product. The UUID remains the primary key; nothing
  /// internal reads this one.
  externalId       BigInt        @unique @default(autoincrement())
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  title            String
  slug             String        @unique
  tagline          String?
  storyDescription String?
  status           ProductStatus @default(DRAFT)

  // Manual storefront override, kept separate from lifecycle status so the two
  // can never disagree. Real availability = LIVE && !forceOutOfStock && stock>0.
  forceOutOfStock Boolean @default(false)

  badgeText             String?
  isFeatured            Boolean @default(false)
  displayOrder          Int     @default(1)
  isSubscriptionAllowed Boolean @default(false)

  /// What a customer saves by subscribing rather than buying once. Shown on
  /// the product page — a subscription with no visible saving is only a
  /// commitment.
  subscriptionDiscountPercent Int @default(0)

  /// A bundle is sold as one line but ships as its components. A flag rather
  /// than a separate model, so hampers stay in one catalogue, one editor and
  /// one set of storefront queries.
  isBundle Boolean @default(false)

  batchCode String?
  verified  Boolean @default(false)

  // Indian GST compliance — rates differ per product line (milk 0%, honey 5%,
  // ghee 12%), so this belongs on the product, not a global constant.
  hsnCode String?
  gstRate Decimal @default(0.00) @db.Decimal(5, 2)

  metaTitle       String?
  metaDescription String?

  // Per-category attributes stay schemaless on purpose: dairy needs fat content
  // and Bilona process, oil needs extraction method, honey needs floral source.
  // A rigid column set or an EAV table would both be worse here.
  specifications Json?
  nutritionFacts Json?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants      ProductVariant[]
  bundleItems   BundleItem[]        @relation("BundleContents")
  collections   ProductCollection[]
  galleryImages ProductImage[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  subscriptions Subscription[]
  labReports    LabReport[]
  reviews       ProductReview[]

  @@index([categoryId])
  @@index([status])
  @@index([status, isFeatured])
  @@index([status, displayOrder])
}

/// A bundle's contents. Stock and cost are derived from the components rather
/// than tracked separately, so a hamper cannot oversell the ghee inside it.
model BundleItem {
  id        String         @id @default(uuid())
  /// The bundle being sold.
  bundleId  String
  bundle    Product        @relation("BundleContents", fields: [bundleId], references: [id], onDelete: Cascade)
  /// A specific size of a specific product, because a hamper contains a 500ml
  /// jar, not "some ghee".
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int            @default(1)

  @@unique([bundleId, variantId])
  @@index([variantId])
}

model ProductVariant {
  id                String  @id @default(uuid())
  /// A stable numeric id for systems that cannot hold a UUID. An external
  /// system stores it and sends it back on every order, so it must never be
  /// reused — a recycled number points their existing orders
  /// at a different size. The UUID remains the primary key; nothing
  /// internal reads this one.
  externalId       BigInt        @unique @default(autoincrement())
  productId         String
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String  @unique
  barcode           String?
  sizeLabel         String
  sellingPrice      Decimal @db.Decimal(10, 2)
  mrpPrice          Decimal @db.Decimal(10, 2)
  stockQuantity     Int     @default(0)
  lowStockThreshold Int     @default(10)

  packagingCode String?
  packaging     PackagingOption? @relation(fields: [packagingCode], references: [code])

  // Courier rates are charged per kg and per volumetric weight — without these
  // we cannot quote or book a Delhivery shipment.
  weightGrams Int?
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?

  imageUrl     String?
  isActive     Boolean  @default(true)
  /// Gives this size its own card on the homepage shelf, instead of the
  /// product appearing once at its default size. Per variant rather than per
  /// product because a product with four sizes would otherwise flood the
  /// shelf — the shopkeeper picks the one or two worth featuring.
  showOnHome   Boolean  @default(false)
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]
  subscriptions  Subscription[]
  stockMovements StockMovement[]

  bundledIn BundleItem[]

  @@index([productId])
  @@index([productId, isActive])
  @@index([stockQuantity])
  @@index([packagingCode])
}

/// Product gallery entry. Named ProductImage for historical reasons; it now
/// carries video too, distinguished by mediaType so the gallery stays a single
/// ordered list rather than two collections the UI has to interleave.
model ProductImage {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl         String
  mediaType        MediaType @default(IMAGE)
  /// Poster frame for a video. Ignored for images.
  thumbnailUrl     String?
  /// Video length in seconds, for showing a duration badge.
  durationSeconds  Int?
  variantId        String?
  isPrimary        Boolean   @default(false)
  isVariantPrimary Boolean   @default(false)
  altText          String?
  displayOrder     Int       @default(1)
  createdAt        DateTime  @default(now())

  @@index([productId])
  @@index([productId, displayOrder])
  @@index([variantId])
  @@index([productId, mediaType])
}

// Every stock change is an auditable row. "Why is this SKU at 3 units?" should
// be answerable without guessing.
model StockMovement {
  id           String              @id @default(uuid())
  variantId    String
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change       Int // negative for a sale, positive for a restock
  balanceAfter Int
  reason       StockMovementReason
  referenceId  String? // order id, subscription delivery id, etc.
  note         String?
  actorId      String?
  createdAt    DateTime            @default(now())

  @@index([variantId, createdAt])
  @@index([referenceId])
}

/// A lab test on one production batch, surfaced on the product page as proof
/// of purity. `parameters` holds the tested rows as
/// [{ name, value, standard?, passed? }] so a ghee report (milk fat, Reichert
/// value) and a honey report (moisture, HMF) can use the same table without a
/// schema change per product line.
model LabReport {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber String
  testDate    DateTime
  labName     String?
  /// Optional: labs email the PDF days after the results. Requiring it here is
  /// how a placeholder URL ends up published as evidence.
  fileUrl     String?
  notes       String?
  parameters  Json
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, batchNumber])
  @@index([productId])
  @@index([batchNumber])
  @@index([testDate])
}

// ---------------------------------------------------------------------------
// Cart & Orders
//
// Cart and order lines reference a ProductVariant, not a Product. Price, MRP,
// SKU, stock and packaging all live on the variant, so a Product-level line
// could not express which size the customer actually bought.
// ---------------------------------------------------------------------------

model CartItem {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Keyed on the variant so 500ml and 1L of the same product can coexist —
  // the old [userId, productId] key made that impossible.
  @@unique([userId, variantId])
  @@index([userId])
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  description       String?
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Decimal      @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  minOrderAmount    Decimal      @default(0.00) @db.Decimal(10, 2)
  usageLimit        Int?
  usageCount        Int          @default(0)
  perUserLimit      Int?         @default(1)
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders Order[]

  @@index([isActive, expiresAt])
}

model Order {
  // Human-readable and quotable over WhatsApp — customers cannot read a UUID.
  orderNumber String @unique
  id          String @id @default(uuid())
  /// Null until the order has an owner.
  ///
  /// A guest checkout creates the order before anyone has identified
  /// themselves — Cashfree collects and verifies the phone during payment, and
  /// only then can the order be attached to an account. Ownership checks read
  /// `where: { id, userId }`, so an unclaimed order matches nobody, which is
  /// the behaviour we want until it is claimed.
  userId      String?
  user        User?  @relation(fields: [userId], references: [id])

  /// Proof that this browser is the one that placed the order.
  ///
  /// The confirm route cannot require a session for a guest — there isn't one
  /// yet. Keying it on the order id instead would hand a session to anyone who
  /// guessed one, and `orderNumber` is `max + 1`, so they are trivially
  /// guessable. Hashed rather than stored plainly: this grants a login, so a
  /// database leak must not be a pile of usable session tokens.
  claimTokenHash      String?   @unique
  claimTokenExpiresAt DateTime?

  // Kept for reference, but the authoritative shipping destination is the
  // snapshot below: editing a saved address must not rewrite past orders.
  addressId       String?
  address         Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shippingAddress Json

  subtotal        Decimal @db.Decimal(10, 2)
  discountAmount  Decimal @default(0.00) @db.Decimal(10, 2)
  taxAmount       Decimal @default(0.00) @db.Decimal(10, 2)
  deliveryCharges Decimal @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)
  currency        String  @default("INR")

  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // Logistics
  /// Courier by default: the shop delivers across India, and the local van
  /// round is the exception rather than the rule. The desk moves an order to
  /// LOCAL when the address turns out to be inside the van's area — nothing at
  /// checkout can know that.
  deliveryType     DeliveryType @default(COURIER)
  driverId         String?
  driver           User?        @relation("DriverAssignment", fields: [driverId], references: [id], onDelete: SetNull)
  shippingCarrier  String?
  trackingNumber   String?
  shippingLabelUrl String?
  shippingStatus   String?
  deliveryOtp      String?

  customerNote String?
  internalNote String?
  cancelReason String?

  /// Ghee and honey are gifting products in India. A gift ships to someone who
  /// did not order it, carries a message, and must not have the price on the
  /// packing slip.
  isGift         Boolean @default(false)
  giftMessage    String?
  giftSenderName String?

  /// Set when the customer has been asked to review what they bought, so they
  /// are asked once rather than every time a job runs.
  reviewRequestedAt DateTime?

  /// Assigned when the supply actually happens, not when the order is placed.
  /// A GST invoice series must be consecutive with no gaps for the financial
  /// year, so an order cancelled before dispatch must never consume a number —
  /// which is exactly what reusing orderNumber here would have done.
  invoiceNumber String?   @unique
  invoicedAt    DateTime?

  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems     OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]
  supportTickets SupportTicket[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([driverId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

// An order line is an immutable financial record. Everything needed to reprint
// the invoice years later is copied in at purchase time — renaming or archiving
// a product must never alter order history.
model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productTitle     String
  variantSizeLabel String
  sku              String
  imageUrl         String?
  hsnCode          String?

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  mrpPrice  Decimal @db.Decimal(10, 2)
  gstRate   Decimal @default(0.00) @db.Decimal(5, 2)
  taxAmount Decimal @default(0.00) @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

/// Every webhook the gateway delivers, keyed by its event id.
///
/// Razorpay retries a webhook until it gets a 2xx, and retries carry the same
/// event id. Without this table a retried `payment.captured` would confirm the
/// order twice and, once refunds are wired, could refund twice.
model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String    @default("RAZORPAY")
  eventId     String
  eventType   String
  /// Set once handling succeeds; a row with this null was received but failed,
  /// so a retry is allowed to try again.
  processedAt DateTime?
  orderId     String?
  payload     Json
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([eventType])
  @@index([createdAt])
}

model Payment {
  id       String          @id @default(uuid())
  orderId  String
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount   Decimal         @db.Decimal(10, 2)
  currency String          @default("INR")
  provider PaymentProvider @default(RAZORPAY)
  status   PaymentStatus   @default(PENDING)

  // Single source of truth for gateway state — these no longer also live on
  // Order, where they could drift out of sync.
  gatewayOrderId   String?
  gatewayPaymentId String?  @unique
  gatewaySignature String?
  refundedAmount   Decimal  @default(0.00) @db.Decimal(10, 2)
  failureReason    String?
  rawPayload       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

model Subscription {
  id           String                @id @default(uuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product               @relation(fields: [productId], references: [id])
  variantId    String
  variant      ProductVariant        @relation(fields: [variantId], references: [id])
  quantity     Int                   @default(1)
  frequency    SubscriptionFrequency @default(DAILY)
  daysOfWeek   Int[]
  startDate    DateTime
  endDate      DateTime?
  status       SubscriptionStatus    @default(ACTIVE)
  nextDelivery DateTime
  pausedUntil  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  deliveries SubscriptionDelivery[]

  @@index([userId])
  @@index([status, nextDelivery])
}

model SubscriptionDelivery {
  id             String         @id @default(uuid())
  subscriptionId String
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deliveryDate   DateTime
  status         DeliveryStatus @default(SCHEDULED)
  quantity       Int
  priceCharged   Decimal        @db.Decimal(10, 2)
  driverId       String?
  skipReason     String?
  createdAt      DateTime       @default(now())

  @@index([subscriptionId])
  @@index([deliveryDate, status])
}

model WalletTransaction {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal         @db.Decimal(10, 2)
  type         TransactionType
  balanceAfter Decimal         @db.Decimal(10, 2)
  description  String
  referenceId  String?
  actorId      String?
  createdAt    DateTime        @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model ProductReview {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  comment            String?
  /// Customer photos and video. Parallel arrays: mediaTypes[i] describes
  /// mediaUrls[i], so a review can mix both without a join table.
  mediaUrls          String[]
  mediaTypes         MediaType[]
  isVerifiedPurchase Boolean      @default(false)
  /// Reviews publish immediately, so there is no approval state — only a
  /// takedown. Set means hidden from customers but recoverable; the row is
  /// only really gone when it is deleted a second time, from the deleted list.
  deletedAt          DateTime?
  deletedBy          String?
  editedAt           DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // No unique on [userId, productId]: a customer may review a product more
  // than once, for instance after reordering a later batch.
  @@index([userId, productId])
  @@index([productId, deletedAt])
  @@index([deletedAt, createdAt])
}

// ---------------------------------------------------------------------------
// CMS & Operations
// ---------------------------------------------------------------------------

/// Editable long-form pages — About, Our Farm, Traceability, FAQ. These are
/// currently hardcoded in the Next.js app, so changing a sentence needs a
/// deploy and the owner cannot touch their own story.
model ContentPage {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  subtitle    String?
  /// Markdown. Rendered on the storefront; edited in the console.
  body        String
  heroImage   String?
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished])
}

model HeroBanner {
  id           String     @id @default(uuid())
  title        String
  subtitle     String
  imageUrl     String
  deviceType   BannerType @default(DESKTOP)
  ctaText      String     @default("Order Fresh Now")
  ctaLink      String     @default("/products")
  badgeText    String?    @default("FARM FRESH")
  /// True when the artwork already carries its own headline — the poster-style
  /// banners exported from a design tool. The storefront then shows the image
  /// whole and lays no text over it. Added on feature/devbhoomi-redesign;
  /// carried here so both branches agree with the database.
  imageHasText Boolean    @default(false)
  /// Where the text sits on the artwork, and how it is set.
  ///
  /// One JSON column rather than a dozen scalars: the shape is a whole layout
  /// that only ever moves together, and it carries a version so an older
  /// banner keeps rendering when the editor grows a field. Null means the
  /// original hardcoded left-aligned stack, which is what every existing
  /// banner should keep looking like.
  layout       Json?
  /// A festival banner should retire itself. Without a window somebody has to
  /// remember to take Diwali down in November.
  startsAt     DateTime?
  endsAt       DateTime?
  displayOrder Int        @default(1)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([deviceType, isActive, displayOrder])
}

model TrustBadge {
  id           String   @id @default(uuid())
  title        String
  subtitle     String
  iconName     String   @default("ShieldCheck")
  displayOrder Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model AnnouncementBanner {
  id              String    @id @default(uuid())
  message         String
  linkUrl         String?
  backgroundColor String    @default("#3A6038")
  textColor       String    @default("#FFFFFF")
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
}

// Site-wide settings the admin edits (WhatsApp number, order message template,
// support hours). Key/value keeps this extensible without a migration per knob.
model StoreSetting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName      String   @default("System")
  action        String
  entity        String
  entityId      String?
  payloadBefore Json?
  payloadAfter  Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

model FeatureFlag {
  id                String   @id @default(uuid())
  key               String   @unique
  description       String
  isEnabled         Boolean  @default(false)
  rolloutPercentage Int      @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Storefront events land here so the admin Overview dashboard reports real
// numbers instead of the hardcoded arrays it renders today.
model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventName  String
  productId  String?
  variantId  String?
  sessionId  String?
  userId     String?
  deviceType String?
  referrer   String?
  path       String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([productId, createdAt])
  @@index([createdAt])
}

/// A question from a customer, and the conversation that answers it.
///
/// Support used to happen entirely on WhatsApp, which is immediate but leaves
/// no record: nobody could see what was asked last week, whether it was
/// answered, or how often the same thing comes up. This keeps the thread
/// against the order it is about.
model SupportTicket {
  id        String  @id @default(uuid())
  ticketRef String  @unique
  /// Null for a query sent from the contact form by someone who has not
  /// signed in. A contact form that demands an account turns away the person
  /// most likely to be asking whether they should buy at all.
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// How to answer a guest. Ignored when userId is set, so the account stays
  /// the source of truth and the form cannot claim to be someone else.
  contactName  String?
  contactEmail String?

  /// Most questions are about a specific order. Null for the general ones.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  subject     String
  status      SupportStatus @default(OPEN)
  /// Set when staff reply, so an inbox can be sorted by who is waiting.
  lastReplyAt DateTime?
  closedAt    DateTime?

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SupportMessage {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Null once the author closes their account — the thread survives erasure
  /// with the person removed from it.
  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Recorded rather than derived from the author's current role: a staff
  /// member who later becomes a customer must not turn old replies into
  /// customer messages.
  fromStaff  Boolean @default(false)
  authorName String

  body String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

enum SupportStatus {
  OPEN
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}

/// Allocates the next number in a named, human-facing series.
///
/// One row per series per period — `order:2026`, `invoice:CD/2026-27` — so a
/// new series (credit notes, RMAs, purchase orders) needs a new key and no
/// schema change.
///
/// Exists because the numbers used to be derived from `max(orderNumber) + 1`,
/// which reused a number whenever an order was deleted, raced when two people
/// checked out at once, and broke permanently past 99,999 because the maximum
/// was found with a *text* sort.
model NumberSeries {
  /// `<series>:<period>`. Opaque to the database, meaningful to the caller.
  key       String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}
