{
  "name": "@country-dairy/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "build": "tsc --build && prisma generate",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1"
  },
  "devDependencies": {
    "@country-dairy/tsconfig": "*",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.16.1",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
