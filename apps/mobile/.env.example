# Copied to .env for local work. Expo reads .env automatically and inlines
# anything prefixed EXPO_PUBLIC_ at build time.
#
# On a simulator localhost is the host machine, so this works. On a real
# handset localhost is the phone, so use the machine's LAN address there —
# e.g. http://192.168.1.20:4000/api — or point at the dev API on Render.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
