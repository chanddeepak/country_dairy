# Copied to .env for local work. Expo reads .env automatically and inlines
# anything prefixed EXPO_PUBLIC_ at build time.
#
# The deployed dev API is the sensible default: stable, reachable from a real
# handset on mobile data, and backed by the same database as the console.
EXPO_PUBLIC_API_URL=https://country-dairy-api-dev.onrender.com/api

# To work against an API running on this machine instead, use its LAN address
# rather than localhost — on a handset or an Android emulator, localhost is
# the device itself. Find it with: ipconfig getifaddr en0
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api
