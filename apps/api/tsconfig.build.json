{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Emits dist/main.js rather than dist/src/main.js. The base config keeps
    // rootDir at the package root so ts-jest can compile specs alongside src.
    "rootDir": "./src",
    // Must live inside outDir: nest-cli deletes dist on every build, and a
    // cache file outside it would survive and convince tsc there is nothing
    // to emit, leaving dist empty.
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
