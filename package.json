{
  "name": "country-dairy-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "git clean -xdf node_modules",
    "db:migrate": "npm run db:migrate --workspace packages/database --",
    "db:deploy": "npm run db:deploy --workspace packages/database",
    "db:status": "npm run db:status --workspace packages/database",
    "db:studio": "npm run db:studio --workspace packages/database",
    "db:seed": "npm run db:seed --workspace packages/database",
    "db:generate": "npm run db:generate --workspace packages/database",
    "smoke": "node scripts/smoke-test.js",
    "test": "npm run test --workspace apps/api",
    "test:contract": "node scripts/storefront-contract-test.js",
    "verify": "npm test && npm run smoke && npm run test:contract && npm run test:catalog && npm run test:media && npm run test:lab && npm run test:delivery",
    "test:catalog": "node scripts/catalog-audit-test.js",
    "test:media": "node scripts/media-test.js",
    "test:lab": "node scripts/lab-reports-test.js",
    "test:delivery": "node scripts/delivery-test.js"
  },
  "prisma": {
    "seed": "node packages/database/prisma/seed.js"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.1.4",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-darwin-arm64": "1.32.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.2",
    "@tailwindcss/oxide-darwin-arm64": "4.3.2"
  },
  "overrides": {
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.7"
  }
}
