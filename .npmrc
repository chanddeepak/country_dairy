legacy-peer-deps=true

# `supportedArchitectures` used to live here. It is a pnpm setting; npm does
# not understand it and printed "Unknown project config" on every install
# while doing nothing. The problem it was meant to solve — a lockfile built on
# macOS carrying only the darwin binary, so a Linux CI build cannot find its
# native binding — is handled by declaring the platform packages explicitly in
# the workspace that needs them.
